{
    "name": "dmytrof/import-bundle",
    "type": "symfony-bundle",
    "description": "Symfony Bundle to import data",
    "keywords": ["Import"],
    "license": "MIT",
    "authors": [
        {
            "name": "Dmytro Feshchenko",
            "email": "dmytro.feshchenko@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-dom": "*",
        "ext-json": "*",
        "ext-simplexml": "*",
        "dmytrof/models-management-bundle": "^1.12",
        "doctrine/collections": "^2.2 || ^3.0",
        "doctrine/doctrine-bundle": "^2.13 || ^3.0",
        "doctrine/inflector": "^2.0",
        "doctrine/orm": "^3.0",
        "doctrine/persistence": "^3.1 || ^4.0",
        "gedmo/doctrine-extensions": "^3.16",
        "guzzlehttp/guzzle": "^7.0",
        "laminas/laminas-feed": "^2.22",
        "laminas/laminas-json": "^3.6",
        "laminas/laminas-xml2json": "^3.3",
        "monolog/monolog": "^2.9 || ^3.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/log": "^2.0 || ^3.0",
        "symfony/config": "^6.4 || ^7.0 || ^8.0",
        "symfony/console": "^6.4 || ^7.0 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.0 || ^8.0",
        "symfony/doctrine-bridge": "^6.4 || ^7.0 || ^8.0",
        "symfony/event-dispatcher": "^6.4 || ^7.0 || ^8.0",
        "symfony/event-dispatcher-contracts": "^3.0",
        "symfony/filesystem": "^6.4 || ^7.0 || ^8.0",
        "symfony/form": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-client": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-foundation": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.0 || ^8.0",
        "symfony/lock": "^6.4 || ^7.0 || ^8.0",
        "symfony/monolog-bundle": "^3.10 || ^4.0",
        "symfony/options-resolver": "^6.4 || ^7.0 || ^8.0",
        "symfony/routing": "^6.4 || ^7.0 || ^8.0",
        "symfony/translation": "^6.4 || ^7.0 || ^8.0",
        "symfony/translation-contracts": "^3.0",
        "symfony/validator": "^6.4 || ^7.0 || ^8.0",
        "symfony/yaml": "^6.4 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "ext-pdo_sqlite": "*",
        "phpunit/phpunit": "^11.5",
        "symfony/framework-bundle": "^6.4 || ^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Dmytrof\\ImportBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dmytrof\\ImportBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
